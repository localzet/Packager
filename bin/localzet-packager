declare(strict_types=1);

require dirname(__DIR__) . '/vendor/autoload.php';

use Localzet\Packager\BuildCommand;
use Localzet\Packager\Manifest;

$command = $argv[1] ?? 'help';
$manifestPath = $argv[2] ?? '';

if ($command === 'help' || $command === '--help' || $command === '-h') {
    fwrite(STDOUT, "Localzet Packager\n\nUsage:\n  localzet-packager validate <manifest.json>\n  localzet-packager build <manifest.json>\n");
    exit(0);
}

if (!in_array($command, ['validate', 'build'], true) || $manifestPath === '') {
    fwrite(STDERR, "Expected: validate|build <manifest.json>\n");
    exit(2);
}

try {
    $manifest = Manifest::load($manifestPath);
    if ($command === 'validate') {
        fwrite(STDOUT, "Manifest is valid for {$manifest->target()} (SPC {$manifest->toolchainVersion()}).\n");
        exit(0);
    }

    $artifact = (new BuildCommand())->run($manifest);
    fwrite(STDOUT, "Built {$artifact['binary']}\nSHA-256 {$artifact['sha256']}\nSBOM {$artifact['sbom']}\nSBOM SHA-256 {$artifact['sbom_sha256']}\n");
} catch (Throwable $exception) {
    fwrite(STDERR, 'Error: ' . $exception->getMessage() . "\n");
    exit(1);
}
